<script>
// ==================== INDEXEDDB STORAGE ====================
class IndexedDBStorage {
    constructor() {
        this.dbName = 'UltraTodoDB';
        this.dbVersion = 1;
        this.db = null;
        this.ready = this.init();
    }
    init() {
        return new Promise((resolve, reject) => {
            const request = indexedDB.open(this.dbName, this.dbVersion);
            request.onupgradeneeded = (e) => {
                const db = e.target.result;
                if (!db.objectStoreNames.contains('appData')) {
                    db.createObjectStore('appData', { keyPath: 'id' });
                }
            };
            request.onsuccess = (e) => {
                this.db = e.target.result;
                resolve();
            };
            request.onerror = (e) => {
                console.error('IndexedDB error:', e);
                reject(e);
            };
        });
    }
    async get(key) {
        await this.ready;
        return new Promise((resolve, reject) => {
            const tx = this.db.transaction('appData', 'readonly');
            const store = tx.objectStore('appData');
            const request = store.get(key);
            request.onsuccess = () => resolve(request.result ? request.result.value : null);
            request.onerror = () => reject(request.error);
        });
    }
    async set(key, value) {
        await this.ready;
        return new Promise((resolve, reject) => {
            const tx = this.db.transaction('appData', 'readwrite');
            const store = tx.objectStore('appData');
            const request = store.put({ id: key, value: value });
            request.onsuccess = () => resolve();
            request.onerror = () => reject(request.error);
        });
    }
    async delete(key) {
        await this.ready;
        return new Promise((resolve, reject) => {
            const tx = this.db.transaction('appData', 'readwrite');
            const store = tx.objectStore('appData');
            const request = store.delete(key);
            request.onsuccess = () => resolve();
            request.onerror = () => reject(request.error);
        });
    }
    async getAll() {
        await this.ready;
        return new Promise((resolve, reject) => {
            const tx = this.db.transaction('appData', 'readonly');
            const store = tx.objectStore('appData');
            const request = store.getAll();
            request.onsuccess = () => {
                const result = {};
                request.result.forEach(item => { result[item.id] = item.value; });
                resolve(result);
            };
            request.onerror = () => reject(request.error);
        });
    }
}

class UltraTodoApp {
    constructor() {
        this.storage = new IndexedDBStorage();
        this.data = null;
        this.currentView = 'today';
        this.theme = 'light';
        this.isListening = false;
        this.recognition = null;
        this.voiceTasks = [];
        this.connectedPeers = [];
        this.myCode = '';
        this.mindMapZoom = 1;
        this.mindMapPanX = 0;
        this.mindMapPanY = 0;
        this.mindMapConnectingFrom = null;
        this.mindMapNodePositions = {};
        this.peersData = {};
        this.init();
    }

    async init() {
        // Charger depuis IndexedDB
        try {
            const savedData = await this.storage.get('todoData');
            this.data = savedData || { tasks: [], projects: [], templates: [], settings: { pomodoroLength: 25, masterPassword: null } };
            const savedTheme = await this.storage.get('theme');
            this.theme = savedTheme || 'light';
            const savedCode = await this.storage.get('connectionCode');
            this.myCode = savedCode || this.generateConnectionCode();
            const savedPeers = await this.storage.get('peers');
            this.connectedPeers = savedPeers || [];
            const savedPeersData = await this.storage.get('peersData');
            this.peersData = savedPeersData || {};
        } catch(e) {
            console.log('IndexedDB non disponible, fallback localStorage');
            this.data = JSON.parse(localStorage.getItem('ultraTodoData') || 'null') || { tasks: [], projects: [], templates: [], settings: { pomodoroLength: 25, masterPassword: null } };
            this.theme = localStorage.getItem('todoTheme') || 'light';
            this.myCode = localStorage.getItem('myConnectionCode') || this.generateConnectionCode();
            this.connectedPeers = JSON.parse(localStorage.getItem('connectedPeers') || '[]');
            this.peersData = JSON.parse(localStorage.getItem('peersData') || '{}');
        }
        
        this.applyTheme();
        this.setupVoiceRecognition();
        this.render();
        this.setupAutoSave();
        this.checkReminders();
        
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.menu-dropdown') && !e.target.closest('.btn-icon')) {
                document.getElementById('menuDropdown').classList.remove('active');
            }
        });
    }

    async saveData() {
        try {
            await this.storage.set('todoData', this.data);
            await this.storage.set('theme', this.theme);
            await this.storage.set('connectionCode', this.myCode);
            await this.storage.set('peers', this.connectedPeers);
            await this.storage.set('peersData', this.peersData);
        } catch(e) {
            // Fallback localStorage
            localStorage.setItem('ultraTodoData', JSON.stringify(this.data));
            localStorage.setItem('todoTheme', this.theme);
            localStorage.setItem('myConnectionCode', this.myCode);
            localStorage.setItem('connectedPeers', JSON.stringify(this.connectedPeers));
            localStorage.setItem('peersData', JSON.stringify(this.peersData));
        }
    }

    setupAutoSave() { setInterval(() => this.saveData(), 5000); }
    generateId() { return 'id_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 5); }

    generateConnectionCode() {
        let code = '';
        // Essayer IndexedDB d'abord
        try {
            this.storage.get('connectionCode').then(saved => {
                if (saved) code = saved;
                else {
                    code = Math.floor(100000 + Math.random() * 900000).toString();
                    this.storage.set('connectionCode', code);
                }
            });
        } catch(e) {
            code = localStorage.getItem('myConnectionCode') || Math.floor(100000 + Math.random() * 900000).toString();
            localStorage.setItem('myConnectionCode', code);
        }
        return code || Math.floor(100000 + Math.random() * 900000).toString();
    }

    showToast(message) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
    }
    toggleTheme() {
        this.theme = this.theme === 'light' ? 'dark' : 'light';
        this.applyTheme();
        this.saveData();
    }
    applyTheme() { if (this.theme === 'dark') document.body.classList.add('dark-theme'); else document.body.classList.remove('dark-theme'); }
    toggleMenu(event) { event.stopPropagation(); document.getElementById('menuDropdown').classList.toggle('active'); }
    toggleFabMenu() {
        const menu = document.getElementById('fabMenu');
        const backdrop = document.getElementById('fabBackdrop');
        const btn = document.getElementById('fabBtn');
        const active = menu.classList.contains('active');
        menu.classList.toggle('active');
        backdrop.classList.toggle('active');
        btn.textContent = active ? '+' : '✕';
    }
    closeFabMenu() {
        document.getElementById('fabMenu').classList.remove('active');
        document.getElementById('fabBackdrop').classList.remove('active');
        document.getElementById('fabBtn').textContent = '+';
    }
    switchView(view, element) {
        this.currentView = view;
        document.querySelectorAll('.bottom-nav-item').forEach(t => t.classList.remove('active'));
        if (element) element.classList.add('active');
        else { const tab = document.querySelector(`.bottom-nav-item[data-view="${view}"]`); if (tab) tab.classList.add('active'); }
        this.closeFabMenu();
        this.render();
    }
    closeModal() { document.getElementById('modalContainer').innerHTML = ''; }

    // ==================== VOICE ====================
    setupVoiceRecognition() {
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            this.recognition = new SR();
            this.recognition.lang = 'fr-FR';
            this.recognition.continuous = true;
            this.recognition.interimResults = true;
            this.recognition.onresult = (e) => {
                let final = '';
                for (let i = e.resultIndex; i < e.results.length; i++) { if (e.results[i].isFinal) final += e.results[i][0].transcript + ' '; }
                if (final) this.processVoiceTasks(final);
            };
            this.recognition.onend = () => { this.isListening = false; };
        }
    }
    openVoiceModal() {
        this.closeFabMenu();
        if (!this.recognition) { this.showToast('Non supporté'); return; }
        this.voiceTasks = [];
        try { this.recognition.start(); this.isListening = true; } catch(e) {}
        const modalHTML = `
            <div class="modal-overlay active"><div class="modal-sheet">
                <div class="modal-handle"></div>
                <h3 class="modal-title">🎤 Ajout vocal</h3>
                <p style="text-align:center;margin:15px 0;font-size:0.85rem;">Dites "Ajouter [tâche]". Dites "Stop" pour terminer.</p>
                <div id="voiceTasksList" style="max-height:200px;overflow-y:auto;"></div>
                <div style="display:flex;gap:10px;margin-top:15px;">
                    <button class="btn btn-primary" onclick="app.stopVoiceAndSave()">Terminer</button>
                    <button class="btn btn-danger" onclick="app.cancelVoice()">Annuler</button>
                </div>
            </div></div>`;
        document.getElementById('modalContainer').innerHTML = modalHTML;
    }
    processVoiceTasks(transcript) {
        const text = transcript.toLowerCase();
        if (text.includes('stop') || text.includes('terminer') || text.includes('fini')) { this.stopVoiceAndSave(); return; }
        const keywords = ['ajouter', 'créer', 'nouvelle tâche', 'faire', 'acheter', 'appeler', 'envoyer', 'préparer'];
        for (const kw of keywords) {
            if (text.includes(kw)) {
                let title = text.replace(kw, '').trim();
                title = title.replace(/^(une|un|la|le|les|des)\s+/i, '').replace(/[.?!,;:]+$/g, '').trim();
                if (title && title.length > 2) {
                    const task = { id: this.generateId(), title: title.charAt(0).toUpperCase() + title.slice(1), description: '', priority: 'medium', dueDate: this.currentView === 'today' ? new Date().toISOString().split('T')[0] : null, dueTime: null, tags: ['vocal'], status: 'todo', completed: false, createdAt: new Date().toISOString(), completedAt: null, subtasks: [], project: null, recurring: null, dependencies: [], archived: false };
                    this.voiceTasks.push(task);
                    this.data.tasks.unshift(task);
                    this.saveData();
                    this.updateVoiceTaskList();
                    break;
                }
            }
        }
    }
    updateVoiceTaskList() {
        const list = document.getElementById('voiceTasksList');
        if (list) list.innerHTML = this.voiceTasks.map(t => `<div style="padding:5px 0;font-size:0.85rem;">✓ ${t.title}</div>`).join('');
    }
    stopVoiceAndSave() {
        try { this.recognition.stop(); } catch(e) {}
        if (this.voiceTasks.length > 0) this.showToast(`✅ ${this.voiceTasks.length} tâche(s)`);
        this.closeModal(); this.render();
    }
    cancelVoice() {
        try { this.recognition.stop(); } catch(e) {}
        this.voiceTasks.forEach(t => { this.data.tasks = this.data.tasks.filter(x => x.id !== t.id); });
        this.voiceTasks = []; this.saveData(); this.closeModal(); this.render();
    }

    // ==================== ADD TASK ====================
    openAddTaskModal() {
        this.closeFabMenu();
        const today = new Date().toISOString().split('T')[0];
        const modalHTML = `
            <div class="modal-overlay active" onclick="if(event.target===this)app.closeModal()">
                <div class="modal-sheet">
                    <div class="modal-handle"></div>
                    <h3 class="modal-title">Nouvelle tâche</h3>
                    <div class="form-group"><label class="form-label">Titre *</label><input type="text" class="form-input" id="addTitle" placeholder="Que devez-vous faire ?"></div>
                    <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" id="addDescription" placeholder="Détails..."></textarea></div>
                    <div class="form-row">
                        <div class="form-group"><label class="form-label">Priorité</label><select class="form-select" id="addPriority"><option value="medium">🟡 Moyenne</option><option value="high">🔴 Haute</option><option value="low">🟢 Basse</option></select></div>
                        <div class="form-group"><label class="form-label">Date</label><input type="date" class="form-input" id="addDueDate" value="${today}"></div>
                    </div>
