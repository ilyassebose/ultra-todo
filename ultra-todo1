<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>UltraTodo</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root {
            --primary: #6c5ce7;
            --primary-light: #a29bfe;
            --primary-dark: #4834d4;
            --success: #00b894;
            --warning: #fdcb6e;
            --danger: #e17055;
            --info: #0984e3;
            --bg: #f5f6fa;
            --card: #ffffff;
            --text: #2d3436;
            --text-secondary: #636e72;
            --text-muted: #b2bec3;
            --border: #dfe6e9;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
            --shadow: 0 2px 6px rgba(0,0,0,0.07);
            --shadow-lg: 0 8px 24px rgba(0,0,0,0.1);
            --radius: 14px;
            --radius-sm: 10px;
            --transition: 0.2s ease;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        .dark-theme {
            --bg: #0f0f1a;
            --card: #1e1e2e;
            --text: #e0e0e0;
            --text-secondary: #a0a0b0;
            --text-muted: #6e6e7e;
            --border: #2d2d3d;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }
        .app-header {
            position: sticky; top: 0; z-index: 50;
            background: var(--card);
            padding: 12px 16px;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid var(--border);
        }
        .app-title { font-size: 1.3rem; font-weight: 700; color: var(--primary); }
        .app-title span { color: var(--text); }
        .header-actions { display: flex; gap: 6px; }
        .btn-icon {
            width: 38px; height: 38px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%; border: none;
            background: var(--card); cursor: pointer;
            font-size: 1.1rem; color: var(--text-secondary);
            box-shadow: var(--shadow-sm);
        }
        .bottom-nav {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
            background: var(--card);
            border-top: 1px solid var(--border);
            display: flex; justify-content: space-around;
            padding: 8px 0 16px 0;
        }
        .bottom-nav-item {
            display: flex; flex-direction: column; align-items: center; gap: 2px;
            cursor: pointer; font-size: 0.6rem; color: var(--text-muted);
            background: none; border: none; padding: 5px 12px; border-radius: 12px;
        }
        .bottom-nav-item.active { color: var(--primary); }
        .bottom-nav-item span { font-size: 1.3rem; }
        .fab {
            position: fixed; bottom: 80px; right: 20px; z-index: 60;
            width: 56px; height: 56px; border-radius: 50%;
            background: var(--primary); color: white; border: none;
            font-size: 1.5rem; cursor: pointer;
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.5);
            display: flex; align-items: center; justify-content: center;
        }
        .fab-menu {
            position: fixed; bottom: 140px; right: 20px; z-index: 59;
            display: none; flex-direction: column; gap: 10px;
        }
        .fab-menu.active { display: flex; }
        .fab-menu-item {
            display: flex; align-items: center; gap: 10px;
            background: var(--card); border: none;
            padding: 12px 16px; border-radius: 16px;
            cursor: pointer; font-size: 0.9rem; font-weight: 500;
            color: var(--text); box-shadow: var(--shadow-lg);
        }
        .fab-menu-item .icon { font-size: 1.3rem; width: 30px; text-align: center; }
        .fab-backdrop {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 58;
            background: rgba(0,0,0,0.3); display: none;
        }
        .fab-backdrop.active { display: block; }
        .main-content { padding: 16px; padding-bottom: 120px; max-width: 600px; margin: 0 auto; }
        .task-card {
            background: var(--card); border-radius: var(--radius);
            padding: 14px; margin-bottom: 10px;
            border-left: 3px solid var(--primary-light);
            box-shadow: var(--shadow-sm); transition: var(--transition);
        }
        .task-card.overdue { border-left-color: var(--danger); }
        .task-card.completed { opacity: 0.6; border-left-color: var(--success); }
        .task-card.blocked { border-left-color: var(--warning); }
        .task-header { display: flex; align-items: center; gap: 10px; }
        .task-checkbox {
            width: 22px; height: 22px; border: 2px solid var(--border);
            border-radius: 50%; cursor: pointer; display: flex;
            align-items: center; justify-content: center; flex-shrink: 0;
            background: var(--card); color: white; font-size: 0.7rem;
        }
        .task-checkbox.checked { background: var(--success); border-color: var(--success); }
        .task-title { font-weight: 600; flex: 1; font-size: 0.95rem; word-break: break-word; }
        .task-title.completed { text-decoration: line-through; color: var(--text-muted); }
        .task-priority { padding: 3px 8px; border-radius: 8px; font-size: 0.6rem; font-weight: 600; text-transform: uppercase; flex-shrink: 0; }
        .priority-high { background: #fde8e8; color: #c0392b; }
        .priority-medium { background: #fef9e7; color: #f39c12; }
        .priority-low { background: #e8f8f5; color: #00b894; }
        .task-project { font-size: 0.65rem; padding: 3px 8px; background: #e8f4fd; color: #0984e3; border-radius: 8px; flex-shrink: 0; }
        .task-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; font-size: 0.7rem; color: var(--text-muted); }
        .task-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
        .tag { padding: 2px 8px; background: var(--bg); border-radius: 10px; font-size: 0.65rem; color: var(--text-secondary); }
        .task-subtasks { margin-top: 6px; font-size: 0.75rem; color: var(--text-secondary); padding-left: 28px; }
        .subtask-item { display: flex; align-items: center; gap: 6px; padding: 2px 0; }
        .subtask-item.completed { text-decoration: line-through; color: var(--text-muted); }
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); z-index: 100;
            justify-content: center; align-items: flex-end;
        }
        .modal-overlay.active { display: flex; }
        .modal-sheet {
            background: var(--card); border-radius: 20px 20px 0 0;
            padding: 20px; width: 100%; max-width: 600px;
            max-height: 85vh; overflow-y: auto;
            animation: slideUp 0.3s ease;
        }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .modal-handle { width: 40px; height: 4px; background: var(--border); border-radius: 2px; margin: 0 auto 15px; }
        .modal-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 15px; }
        .form-group { margin-bottom: 14px; }
        .form-label { display: block; margin-bottom: 5px; font-weight: 500; font-size: 0.85rem; color: var(--text-secondary); }
        .form-input, .form-select, .form-textarea {
            width: 100%; padding: 12px 14px; border: 1px solid var(--border);
            border-radius: var(--radius-sm); font-size: 0.95rem;
            background: var(--bg); color: var(--text);
            transition: var(--transition); font-family: var(--font);
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus { outline: none; border-color: var(--primary); }
        .form-textarea { min-height: 80px; resize: vertical; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .btn {
            padding: 12px 18px; border: 1px solid var(--border);
            background: var(--card); color: var(--text);
            border-radius: var(--radius-sm); cursor: pointer;
            font-size: 0.9rem; font-weight: 500; transition: var(--transition);
            display: inline-flex; align-items: center; justify-content: center;
            gap: 6px; width: 100%;
        }
        .btn-primary { background: var(--primary); color: white; border-color: var(--primary); }
        .btn-danger { background: var(--danger); color: white; border-color: var(--danger); }
        .search-bar {
            background: var(--card); border-radius: 16px; padding: 10px 14px;
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 16px; border: 1px solid var(--border);
        }
        .search-bar input { flex: 1; border: none; background: none; font-size: 0.95rem; color: var(--text); outline: none; }
        .search-bar .search-icon { color: var(--text-muted); font-size: 1.1rem; }
        .section-header { margin: 15px 0 10px; font-weight: 600; font-size: 0.9rem; color: var(--text-secondary); }
        .today-date { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px; text-align: center; }
        .toast {
            position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%);
            background: var(--text); color: var(--bg);
            padding: 10px 20px; border-radius: 20px;
            font-size: 0.85rem; z-index: 300; opacity: 0;
            transition: opacity 0.3s; pointer-events: none;
        }
        .toast.show { opacity: 1; }
        .menu-dropdown {
            display: none; position: fixed; top: 60px; right: 16px; z-index: 80;
            background: var(--card); border-radius: var(--radius);
            box-shadow: var(--shadow-lg); border: 1px solid var(--border);
            min-width: 200px; padding: 8px;
        }
        .menu-dropdown.active { display: block; }
        .menu-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: var(--radius-sm);
            cursor: pointer; font-size: 0.9rem; color: var(--text);
            background: none; border: none; width: 100%; text-align: left;
        }
        .menu-item .menu-icon { font-size: 1.1rem; width: 24px; text-align: center; }
        .menu-divider { height: 1px; background: var(--border); margin: 6px 0; }
        .code-display {
            font-size: 2rem; font-weight: 700; letter-spacing: 5px;
            color: var(--primary); text-align: center; padding: 15px;
            background: var(--bg); border-radius: var(--radius-sm); margin: 10px 0;
        }
        .analytics-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stat-box { background: var(--card); border-radius: 12px; padding: 15px; text-align: center; box-shadow: var(--shadow-sm); }
        .stat-value { font-size: 1.8rem; font-weight: 700; color: var(--primary); }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }
        canvas { width: 100% !important; height: auto !important; }
        .mindmap-container {
            position: relative; background: var(--bg);
            border-radius: var(--radius); border: 1px solid var(--border);
            height: 50vh; width: 100%; overflow: hidden; touch-action: none;
        }
        .mindmap-zoom-controls { position: absolute; bottom: 15px; right: 15px; display: flex; flex-direction: column; gap: 8px; z-index: 10; }
        .zoom-btn { width: 40px; height: 40px; border-radius: 50%; background: var(--card); border: 1px solid var(--border); font-size: 1.2rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow); color: var(--text); }
        .mindmap-node { position: absolute; background: var(--card); border: 2px solid var(--primary); border-radius: 10px; padding: 8px 12px; font-size: 0.75rem; cursor: pointer; user-select: none; white-space: nowrap; max-width: 160px; overflow: hidden; text-overflow: ellipsis; box-shadow: var(--shadow-sm); }
        .mindmap-node.selected { border-color: var(--danger); box-shadow: 0 0 0 3px rgba(225,112,85,0.3); }
        .mindmap-node.project-node { border-color: var(--info); background: #e8f4fd; }
        @media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

    <header class="app-header">
        <div class="app-title">✓ Ultra<span>Todo</span></div>
        <div class="header-actions">
            <button class="btn-icon" onclick="app.toggleTheme()">🌓</button>
            <button class="btn-icon" onclick="app.toggleMenu(event)">⋮</button>
        </div>
    </header>

    <div class="menu-dropdown" id="menuDropdown">
        <button class="menu-item" onclick="app.openConnectionModal();app.toggleMenu(event)"><span class="menu-icon">🔗</span> Connexion</button>
        <button class="menu-item" onclick="app.switchView('mindmap');app.toggleMenu(event)"><span class="menu-icon">🧠</span> Mind Map</button>
        <button class="menu-item" onclick="app.switchView('analytics');app.toggleMenu(event)"><span class="menu-icon">📈</span> Stats</button>
        <button class="menu-item" onclick="app.switchView('projects');app.toggleMenu(event)"><span class="menu-icon">📁</span> Projets</button>
        <button class="menu-item" onclick="app.switchView('templates');app.toggleMenu(event)"><span class="menu-icon">📦</span> Modèles</button>
        <div class="menu-divider"></div>
        <button class="menu-item" onclick="app.exportData('json');app.toggleMenu(event)"><span class="menu-icon">📤</span> Export JSON</button>
        <button class="menu-item" onclick="app.exportData('csv');app.toggleMenu(event)"><span class="menu-icon">📊</span> Export CSV</button>
        <button class="menu-item" onclick="app.importData();app.toggleMenu(event)"><span class="menu-icon">📥</span> Import</button>
    </div>

    <main class="main-content" id="mainContent"></main>

    <div class="fab-backdrop" id="fabBackdrop" onclick="app.closeFabMenu()"></div>
    <div class="fab-menu" id="fabMenu">
        <button class="fab-menu-item" onclick="app.openAddTaskModal()"><span class="icon">✏️</span> Ajouter en écrit</button>
        <button class="fab-menu-item" onclick="app.openVoiceModal()"><span class="icon">🎤</span> Ajouter en vocal</button>
    </div>
    <button class="fab" id="fabBtn" onclick="app.toggleFabMenu()">+</button>

    <nav class="bottom-nav">
        <button class="bottom-nav-item active" data-view="today" onclick="app.switchView('today', this)"><span>⭐</span>Aujourd'hui</button>
        <button class="bottom-nav-item" data-view="list" onclick="app.switchView('list', this)"><span>📋</span>Tâches</button>
        <button class="bottom-nav-item" data-view="mindmap" onclick="app.switchView('mindmap', this)"><span>🧠</span>Mind Map</button>
        <button class="bottom-nav-item" data-view="analytics" onclick="app.switchView('analytics', this)"><span>📈</span>Stats</button>
        <button class="bottom-nav-item" data-view="connections" onclick="app.switchView('connections', this)"><span>🔗</span>Liens</button>
    </nav>

    <div id="modalContainer"></div>
    <div class="toast" id="toast"></div>

<script>
// ============================================
// SUPABASE CONFIGURATION
// ============================================
const SUPABASE_URL = 'https://atksislfvshlpheosnqr.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF0a3Npc2xmdnNobHBoZW9zbnFyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc3Mzg0MzAsImV4cCI6MjEwMzMxNDQzMH0.2DtgmVhxRRxOwJY_ZVnwPJWj5E8YnIlszpVl7_tBAsw';

let supabaseClient = null;
try {
    if (typeof window.supabase !== 'undefined') {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
} catch(e) { console.log('Mode local sans Supabase'); }

class UltraTodoApp {
    constructor() {
        this.data = this.loadData();
        this.currentView = 'today';
        this.theme = localStorage.getItem('todoTheme') || 'light';
        this.isListening = false;
        this.recognition = null;
        this.voiceTasks = [];
        this.connectedPeers = JSON.parse(localStorage.getItem('connectedPeers') || '[]');
        this.myCode = localStorage.getItem('myConnectionCode') || this.generateCode();
        this.peersData = JSON.parse(localStorage.getItem('peersData') || '{}');
        this.init();
    }

    init() {
        this.applyTheme();
        this.setupVoice();
        this.render();
        this.autoSave();
    }

    loadData() {
        const saved = localStorage.getItem('ultraTodoData');
        if (saved) { try { return JSON.parse(saved); } catch(e) {} }
        return { tasks: [], projects: [], templates: [], settings: {} };
    }

    saveData() { localStorage.setItem('ultraTodoData', JSON.stringify(this.data)); }
    autoSave() { setInterval(() => this.saveData(), 5000); }
    generateId() { return 'id_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 5); }
    generateCode() {
        const code = Math.floor(100000 + Math.random() * 900000).toString();
        localStorage.setItem('myConnectionCode', code);
        return code;
    }

    showToast(msg) {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2000);
    }

    toggleTheme() { this.theme = this.theme === 'light' ? 'dark' : 'light'; localStorage.setItem('todoTheme', this.theme); this.applyTheme(); }
    applyTheme() { if (this.theme === 'dark') document.body.classList.add('dark-theme'); else document.body.classList.remove('dark-theme'); }
    toggleMenu(e) { e.stopPropagation(); document.getElementById('menuDropdown').classList.toggle('active'); }
    toggleFabMenu() {
        const menu = document.getElementById('fabMenu');
        const backdrop = document.getElementById('fabBackdrop');
        const btn = document.getElementById('fabBtn');
        const active = menu.classList.contains('active');
        menu.classList.toggle('active');
        backdrop.classList.toggle('active');
        btn.textContent = active ? '+' : '✕';
    }
    closeFabMenu() { document.getElementById('fabMenu').classList.remove('active'); document.getElementById('fabBackdrop').classList.remove('active'); document.getElementById('fabBtn').textContent = '+'; }
    switchView(view, el) {
        this.currentView = view;
        document.querySelectorAll('.bottom-nav-item').forEach(t => t.classList.remove('active'));
        if (el) el.classList.add('active');
        this.closeFabMenu();
        this.render();
    }
    closeModal() { document.getElementById('modalContainer').innerHTML = ''; }

    setupVoice() {
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            this.recognition = new SR();
            this.recognition.lang = 'fr-FR';
            this.recognition.continuous = true;
            this.recognition.interimResults = true;
            this.recognition.onresult = (e) => {
                let final = '';
                for (let i = e.resultIndex; i < e.results.length; i++) { if (e.results[i].isFinal) final += e.results[i][0].transcript + ' '; }
                if (final) this.processVoice(final);
            };
        }
    }

    openVoiceModal() {
        this.closeFabMenu();
        if (!this.recognition) { this.showToast('Non supporté'); return; }
        this.voiceTasks = [];
        try { this.recognition.start(); } catch(e) {}
        document.getElementById('modalContainer').innerHTML = `
            <div class="modal-overlay active"><div class="modal-sheet"><div class="modal-handle"></div>
                <h3 class="modal-title">🎤 Ajout vocal</h3>
                <p style="text-align:center;margin:15px 0;">Dites "Ajouter [tâche]". Dites "Stop" pour terminer.</p>
                <div id="voiceList" style="max-height:200px;overflow-y:auto;"></div>
                <div style="display:flex;gap:10px;margin-top:15px;"><button class="btn btn-primary" onclick="app.stopVoice()">Terminer</button><button class="btn btn-danger" onclick="app.cancelVoice()">Annuler</button></div>
            </div></div>`;
    }

    processVoice(text) {
        const t = text.toLowerCase();
        if (t.includes('stop') || t.includes('terminer') || t.includes('fini')) { this.stopVoice(); return; }
        const keywords = ['ajouter', 'créer', 'faire', 'acheter', 'appeler', 'envoyer', 'préparer'];
        for (const kw of keywords) {
            if (t.includes(kw)) {
                let title = t.replace(kw, '').trim().replace(/^(une|un|la|le|les|des)\s+/i, '').replace(/[.?!,;:]+$/g, '').trim();
                if (title && title.length > 2) {
                    const task = { id: this.generateId(), title: title.charAt(0).toUpperCase() + title.slice(1), description: '', priority: 'medium', dueDate: this.currentView === 'today' ? new Date().toISOString().split('T')[0] : null, dueTime: null, tags: ['vocal'], status: 'todo', completed: false, createdAt: new Date().toISOString(), completedAt: null, subtasks: [], project: null, recurring: null, dependencies: [], archived: false };
                    this.voiceTasks.push(task);
                    this.data.tasks.unshift(task);
                    this.saveData();
                    const list = document.getElementById('voiceList');
                    if (list) list.innerHTML = this.voiceTasks.map(t => `<div style="padding:5px 0;">✓ ${t.title}</div>`).join('');
                    break;
                }
            }
        }
    }

    stopVoice() { try { this.recognition.stop(); } catch(e) {} if (this.voiceTasks.length > 0) this.showToast('✅ ' + this.voiceTasks.length + ' tâche(s)'); this.closeModal(); this.render(); }
    cancelVoice() { try { this.recognition.stop(); } catch(e) {} this.voiceTasks.forEach(t => { this.data.tasks = this.data.tasks.filter(x => x.id !== t.id); }); this.voiceTasks = []; this.saveData(); this.closeModal(); this.render(); }

    openAddTaskModal() {
        this.closeFabMenu();
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('modalContainer').innerHTML = `
            <div class="modal-overlay active" onclick="if(event.target===this)app.closeModal()"><div class="modal-sheet"><div class="modal-handle"></div>
                <h3 class="modal-title">Nouvelle tâche</h3>
                <div class="form-group"><label class="form-label">Titre *</label><input type="text" class="form-input" id="addTitle" placeholder="Que devez-vous faire ?"></div>
                <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" id="addDescription"></textarea></div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Priorité</label><select class="form-select" id="addPriority"><option value="medium">🟡 Moyenne</option><option value="high">🔴 Haute</option><option value="low">🟢 Basse</option></select></div>
                    <div class="form-group"><label class="form-label">Date</label><input type="date" class="form-input" id="addDueDate" value="${today}"></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Heure</label><input type="time" class="form-input" id="addDueTime"></div>
                    <div class="form-group"><label class="form-label">Projet</label><select class="form-select" id="addProject"><option value="">Aucun</option>${this.data.projects.map(p => `<option value="${p}">${p}</option>`).join('')}<option value="__new__">+ Nouveau</option></select></div>
                </div>
                <div class="form-group"><label class="form-label">Tags (virgules)</label><input type="text" class="form-input" id="addTags"></div>
                <div class="form-group"><label class="form-label">Sous-tâches (une par ligne)</label><textarea class="form-textarea" id="addSubtasks"></textarea></div>
                <div class="form-group"><label class="form-label">Répétition</label><select class="form-select" id="addRecurring"><option value="">Aucune</option><option value="daily">Quotidien</option><option value="weekly">Hebdomadaire</option><option value="monthly">Mensuel</option></select></div>
                <div style="display:flex;gap:10px;"><button class="btn" onclick="app.closeModal()">Annuler</button><button class="btn btn-primary" onclick="app.saveNewTask()">Ajouter</button></div>
            </div></div>`;
        setTimeout(() => document.getElementById('addTitle').focus(), 100);
    }

    saveNewTask() {
        const titleInput = document.getElementById('addTitle');
        if (!titleInput || !titleInput.value.trim()) { this.showToast('Titre obligatoire'); return; }
        let project = document.getElementById('addProject').value;
        if (project === '__new__') { project = prompt('Nom du projet :'); if (project) this.data.projects.push(project); }
        const subtasksText = document.getElementById('addSubtasks').value.trim();
        const subtasks = subtasksText ? subtasksText.split('\n').map(s => ({ id: this.generateId(), title: s.trim(), completed: false })) : [];
        const task = {
            id: this.generateId(), title: titleInput.value.trim(),
            description: document.getElementById('addDescription').value.trim(),
            priority: document.getElementById('addPriority').value,
            dueDate: document.getElementById('addDueDate').value || null,
            dueTime: document.getElementById('addDueTime').value || null,
            tags: (document.getElementById('addTags').value || '').split(',').map(s => s.trim()).filter(s => s),
            status: 'todo', completed: false, createdAt: new Date().toISOString(), completedAt: null,
            subtasks, project: project || null,
            recurring: document.getElementById('addRecurring').value || null,
            dependencies: [], archived: false
        };
        this.data.tasks.unshift(task);
        this.saveData();
        this.closeModal();
        this.showToast('✅ Tâche ajoutée');
        this.render();
    }

    render() {
        const content = document.getElementById('mainContent');
        if (this.currentView === 'today') this.renderToday(content);
        else if (this.currentView === 'list') this.renderList(content);
        else if (this.currentView === 'analytics') this.renderAnalytics(content);
        else if (this.currentView === 'connections') this.renderConnections(content);
        else if (this.currentView === 'projects') this.renderProjects(content);
        else if (this.currentView === 'templates') this.renderTemplates(content);
        else if (this.currentView === 'mindmap') this.renderMindMap(content);
        else this.renderToday(content);
    }

    renderToday(container) {
        const today = new Date().toISOString().split('T')[0];
        const overdue = this.data.tasks.filter(t => this.isOverdue(t) && !t.completed && !t.archived);
        const todayTasks = this.data.tasks.filter(t => t.dueDate === today && !t.completed && !t.archived);
        const completed = this.data.tasks.filter(t => t.completed && t.completedAt && t.completedAt.split('T')[0] === today);
        const dateStr = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
        let html = `<div class="today-date">${dateStr}</div><div class="search-bar"><span class="search-icon">🔍</span><input type="text" placeholder="Rechercher..." oninput="app.search(this.value)"></div>`;
        if (overdue.length > 0) { html += `<div class="section-header">🔴 En retard (${overdue.length})</div>`; overdue.forEach(t => html += this.taskCard(t)); }
        if (todayTasks.length > 0) { html += `<div class="section-header">📅 Aujourd'hui (${todayTasks.length})</div>`; todayTasks.forEach(t => html += this.taskCard(t)); }
        if (completed.length > 0) { html += `<div class="section-header">✅ Terminées (${completed.length})</div>`; completed.forEach(t => html += this.taskCard(t)); }
        if (overdue.length === 0 && todayTasks.length === 0 && completed.length === 0) html += `<div style="text-align:center;padding:40px;color:var(--text-muted);"><div style="font-size:3rem;">🎉</div><p>Rien à faire !</p></div>`;
        container.innerHTML = html;
    }

    renderList(container) {
        const tasks = this.data.tasks.filter(t => !t.archived).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        let html = `<div class="search-bar"><span class="search-icon">🔍</span><input type="text" placeholder="Rechercher..." oninput="app.search(this.value)"></div>`;
        if (tasks.length === 0) html += `<div style="text-align:center;padding:40px;color:var(--text-muted);">📭 Aucune tâche</div>`;
        else tasks.forEach(t => html += this.taskCard(t));
        container.innerHTML = html;
    }

    taskCard(task) {
        if (task.archived) return '';
        const isOverdue = this.isOverdue(task);
        const pLabel = { high: 'Haute', medium: 'Moyenne', low: 'Basse' }[task.priority] || task.priority;
        return `
            <div class="task-card ${isOverdue ? 'overdue' : ''} ${task.completed ? 'completed' : ''}" onclick="app.openTaskDetail('${task.id}')">
                <div class="task-header">
                    <div class="task-checkbox ${task.completed ? 'checked' : ''}" onclick="event.stopPropagation();app.toggleTask('${task.id}')">${task.completed ? '✓' : ''}</div>
                    <div class="task-title ${task.completed ? 'completed' : ''}">${task.title}</div>
                    <span class="task-priority priority-${task.priority}">${pLabel}</span>
                </div>
                ${task.project ? `<div style="margin-top:4px;"><span class="task-project">📁 ${task.project}</span></div>` : ''}
                ${task.tags && task.tags.length > 0 ? `<div class="task-tags">${task.tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>` : ''}
                <div class="task-meta">
                    ${task.dueDate ? `<span>📅 ${this.formatDate(task.dueDate)}${task.dueTime ? ' ' + task.dueTime : ''}</span>` : ''}
                    ${isOverdue ? '<span style="color:var(--danger);">(retard)</span>' : ''}
                    ${task.recurring ? '<span>🔄</span>' : ''}
                </div>
            </div>`;
    }

    openTaskDetail(taskId) {
        const task = this.data.tasks.find(t => t.id === taskId);
        if (!task) return;
        document.getElementById('modalContainer').innerHTML = `
            <div class="modal-overlay active" onclick="if(event.target===this)app.closeModal()"><div class="modal-sheet"><div class="modal-handle"></div>
                <h3 class="modal-title">${task.completed ? '✅ ' : ''}${task.title}</h3>
                ${task.description ? `<p style="color:var(--text-secondary);margin-bottom:10px;">${task.description}</p>` : ''}
                ${task.subtasks.length > 0 ? `<div class="section-header">Sous-tâches (${task.subtasks.filter(s => s.completed).length}/${task.subtasks.length})</div>` + task.subtasks.map(s => `<div style="display:flex;align-items:center;gap:8px;padding:4px 0;"><input type="checkbox" ${s.completed ? 'checked' : ''} onchange="app.toggleSubtask('${task.id}','${s.id}')"><span style="${s.completed ? 'text-decoration:line-through;' : ''}">${s.title}</span></div>`).join('') : ''}
                <div style="display:flex;gap:10px;margin-top:20px;"><button class="btn" onclick="app.openEditModal('${task.id}')">✏️ Modifier</button><button class="btn btn-danger" onclick="app.deleteTask('${task.id}')">🗑️ Supprimer</button></div>
            </div></div>`;
    }

    openEditModal(taskId) {
        const task = this.data.tasks.find(t => t.id === taskId);
        if (!task) return;
        document.getElementById('modalContainer').innerHTML = `
            <div class="modal-overlay active" onclick="if(event.target===this)app.closeModal()"><div class="modal-sheet"><div class="modal-handle"></div>
                <h3 class="modal-title">Modifier</h3>
                <div class="form-group"><label class="form-label">Titre</label><input type="text" class="form-input" id="editTitle" value="${task.title}"></div>
                <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" id="editDescription">${task.description || ''}</textarea></div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Priorité</label><select class="form-select" id="editPriority"><option value="high" ${task.priority==='high'?'selected':''}>Haute</option><option value="medium" ${task.priority==='medium'?'selected':''}>Moyenne</option><option value="low" ${task.priority==='low'?'selected':''}>Basse</option></select></div>
                    <div class="form-group"><label class="form-label">Statut</label><select class="form-select" id="editStatus"><option value="todo" ${task.status==='todo'?'selected':''}>À faire</option><option value="done" ${task.status==='done'?'selected':''}>Terminé</option></select></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Date</label><input type="date" class="form-input" id="editDueDate" value="${task.dueDate || ''}"></div>
                    <div class="form-group"><label class="form-label">Heure</label><input type="time" class="form-input" id="editDueTime" value="${task.dueTime || ''}"></div>
                </div>
                <div class="form-group"><label class="form-label">Projet</label><select class="form-select" id="editProject"><option value="">Aucun</option>${this.data.projects.map(p => `<option value="${p}" ${task.project===p?'selected':''}>${p}</option>`).join('')}</select></div>
                <div class="form-group"><label class="form-label">Tags</label><input type="text" class="form-input" id="editTags" value="${task.tags.join(', ')}"></div>
                <div class="form-group"><label class="form-label">Répétition</label><select class="form-select" id="editRecurring"><option value="">Aucune</option><option value="daily" ${task.recurring==='daily'?'selected':''}>Quotidien</option><option value="weekly" ${task.recurring==='weekly'?'selected':''}>Hebdomadaire</option><option value="monthly" ${task.recurring==='monthly'?'selected':''}>Mensuel</option></select></div>
                <div class="form-group"><label class="form-label">Dépendances (IDs)</label><input type="text" class="form-input" id="editDependencies" value="${(task.dependencies || []).join(', ')}"></div>
                <div style="display:flex;gap:10px;"><button class="btn" onclick="app.closeModal()">Annuler</button><button class="btn btn-primary" onclick="app.saveEdit('${task.id}')">Enregistrer</button></div>
            </div></div>`;
    }

    saveEdit(taskId) {
        const task = this.data.tasks.find(t => t.id === taskId);
        if (!task) return;
        task.title = document.getElementById('editTitle').value.trim();
        task.description = document.getElementById('editDescription').value.trim();
        task.priority = document.getElementById('editPriority').value;
        task.status = document.getElementById('editStatus').value;
        task.dueDate = document.getElementById('editDueDate').value || null;
        task.dueTime = document.getElementById('editDueTime').value || null;
        task.project = document.getElementById('editProject').value || null;
        task.tags = document.getElementById('editTags').value.split(',').map(s => s.trim()).filter(s => s);
        task.recurring = document.getElementById('editRecurring').value || null;
        task.dependencies = document.getElementById('editDependencies').value.split(',').map(s => s.trim()).filter(s => s);
        if (task.status === 'done') { task.completed = true; task.completedAt = new Date().toISOString(); }
        else { task.completed = false; task.completedAt = null; }
        this.saveData(); this.closeModal(); this.showToast('✅ Modifié'); this.render();
    }

    toggleTask(taskId) {
        const task = this.data.tasks.find(t => t.id === taskId);
        if (task) {
            task.completed = !task.completed;
            task.completedAt = task.completed ? new Date().toISOString() : null;
            task.status = task.completed ? 'done' : 'todo';
            if (task.completed && task.recurring) this.createRecurring(task);
            this.saveData(); this.showToast(task.completed ? '✅ Terminée' : '↩️ Réouverte'); this.render();
        }
    }
    createRecurring(task) {
        const next = new Date(task.dueDate || task.completedAt);
        if (task.recurring === 'daily') next.setDate(next.getDate() + 1);
        else if (task.recurring === 'weekly') next.setDate(next.getDate() + 7);
        else if (task.recurring === 'monthly') next.setMonth(next.getMonth() + 1);
        this.data.tasks.unshift({ ...task, id: this.generateId(), completed: false, completedAt: null, status: 'todo', dueDate: next.toISOString().split('T')[0], createdAt: new Date().toISOString() });
    }
    toggleSubtask(taskId, subtaskId) {
        const task = this.data.tasks.find(t => t.id === taskId);
        if (task) { const sub = task.subtasks.find(s => s.id === subtaskId); if (sub) { sub.completed = !sub.completed; this.saveData(); this.render(); } }
    }
    deleteTask(taskId) {
        if (confirm('Supprimer ?')) { this.data.tasks = this.data.tasks.filter(t => t.id !== taskId); this.saveData(); this.closeModal(); this.showToast('🗑️ Supprimée'); this.render(); }
    }
    isOverdue(task) {
        if (!task.dueDate || task.completed || task.archived) return false;
        const due = new Date(task.dueDate);
        if (task.dueTime) { const [h, m] = task.dueTime.split(':').map(Number); due.setHours(h, m, 0, 0); }
        else due.setHours(23, 59, 59, 999);
        return due < new Date();
    }
    search(q) { const query = q.toLowerCase(); document.querySelectorAll('.task-card').forEach(card => { const t = card.querySelector('.task-title'); if (t) card.style.display = t.textContent.toLowerCase().includes(query) ? '' : 'none'; }); }
    formatDate(dateStr) { return dateStr ? new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : ''; }

    // ==================== CONNECTIONS ====================
    openConnectionModal() {
        document.getElementById('modalContainer').innerHTML = `
            <div class="modal-overlay active" onclick="if(event.target===this)app.closeModal()"><div class="modal-sheet"><div class="modal-handle"></div>
                <h3 class="modal-title">🔗 Connexion</h3>
                <div class="form-group"><label class="form-label">Votre code (à partager)</label><div class="code-display">${this.myCode}</div></div>
                <div class="form-group"><label class="form-label">Code du contact (à entrer)</label>
                    <div style="display:flex;gap:8px;"><input type="text" class="form-input" id="peerCodeInput" placeholder="______" maxlength="6" inputmode="numeric" style="text-align:center;font-size:1.5rem;letter-spacing:8px;flex:1;"><button class="btn btn-primary" style="width:auto;" onclick="app.connectToPeer()">Connecter</button></div>
                </div>
                <div class="menu-divider"></div>
                <div class="form-group"><label class="form-label">Contacts (${this.connectedPeers.length})</label>
                    ${this.connectedPeers.length === 0 ? '<p style="font-size:0.8rem;color:var(--text-muted);">Aucun contact</p>' : this.connectedPeers.map(p => `<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);"><span>👤 ${p.name || 'Contact ' + p.code}</span><button class="btn btn-sm btn-danger" style="width:auto;padding:4px 8px;" onclick="app.disconnectPeer('${p.code}')">✕</button></div>`).join('')}
                </div>
            </div></div>`;
    }
    connectToPeer() {
        const code = document.getElementById('peerCodeInput').value.trim();
        if (code.length !== 6 || !/^\d{6}$/.test(code)) { this.showToast('Code invalide'); return; }
        if (code === this.myCode) { this.showToast('Code identique'); return; }
        if (this.connectedPeers.some(p => p.code === code)) { this.showToast('Déjà connecté'); return; }
        const name = prompt('Nom du contact :', 'Contact ' + code);
        this.connectedPeers.push({ code, name: name || 'Contact ' + code });
        if (!this.peersData[code]) this.peersData[code] = { tasks: [{ id: 'p1', title: 'Tâche partagée 1', priority: 'high', completed: false }, { id: 'p2', title: 'Tâche partagée 2', priority: 'medium', completed: true }], lastSync: new Date().toISOString() };
        localStorage.setItem('connectedPeers', JSON.stringify(this.connectedPeers));
        localStorage.setItem('peersData', JSON.stringify(this.peersData));
        this.showToast('✅ Connecté');
        this.closeModal(); this.render();
    }
    disconnectPeer(code) {
        this.connectedPeers = this.connectedPeers.filter(p => p.code !== code);
        delete this.peersData[code];
        localStorage.setItem('connectedPeers', JSON.stringify(this.connectedPeers));
        localStorage.setItem('peersData', JSON.stringify(this.peersData));
        this.showToast('🔌 Déconnecté'); this.closeModal(); this.render();
    }
    renderConnections(container) {
        let html = `<h3 style="margin-bottom:15px;">🔗 Connexions</h3><div style="background:var(--card);border-radius:var(--radius);padding:15px;margin-bottom:15px;"><div class="form-label">Votre code</div><div class="code-display">${this.myCode}</div><button class="btn btn-primary" onclick="app.openConnectionModal()">Gérer</button></div>`;
        if (this.connectedPeers.length === 0) html += `<div style="text-align:center;padding:40px;color:var(--text-muted);">🔗 Aucune connexion</div>`;
        else this.connectedPeers.forEach(peer => {
            const pd = this.peersData[peer.code] || { tasks: [] };
            const done = pd.tasks.filter(t => t.completed).length;
            html += `<div style="background:var(--card);border-radius:var(--radius);padding:15px;margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:8px;"><strong>👤 ${peer.name}</strong><span>${done}/${pd.tasks.length}</span></div>
                <div style="display:flex;gap:6px;"><button class="btn btn-sm" style="width:auto;" onclick="app.showPeerTasks('${peer.code}')">📋 Tâches</button><button class="btn btn-sm btn-danger" style="width:auto;" onclick="app.disconnectPeer('${peer.code}')">🔌</button></div></div>`;
        });
        container.innerHTML = html;
    }
    showPeerTasks(code) {
        const peer = this.connectedPeers.find(p => p.code === code);
        const pd = this.peersData[code] || { tasks: [] };
        document.getElementById('modalContainer').innerHTML = `<div class="modal-overlay active"><div class="modal-sheet"><div class="modal-handle"></div><h3 class="modal-title">📋 Tâches de ${peer.name}</h3>${pd.tasks.map(t => `<div style="padding:8px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;"><span>${t.completed ? '✅' : '○'}</span><span style="flex:1;">${t.title}</span></div>`).join('')}</div></div>`;
    }

    // ==================== ANALYTICS ====================
    renderAnalytics(container) {
        const total = this.data.tasks.length;
        const completed = this.data.tasks.filter(t => t.completed).length;
        const rate = total > 0 ? Math.round((completed / total) * 100) : 0;
        const overdue = this.data.tasks.filter(t => this.isOverdue(t)).length;
        let streak = 0; const today = new Date();
        for (let i = 0; i < 365; i++) { const d = new Date(today); d.setDate(d.getDate() - i); const ds = d.toISOString().split('T')[0]; if (this.data.tasks.some(t => t.completedAt && t.completedAt.split('T')[0] === ds)) streak++; else if (i > 0) break; }
        container.innerHTML = `<h3 style="margin-bottom:15px;">📈 Stats</h3>
            <div class="analytics-stats">
                <div class="stat-box"><div class="stat-value">${rate}%</div><div class="stat-label">Complétion (${completed}/${total})</div></div>
                <div class="stat-box"><div class="stat-value">${overdue}</div><div class="stat-label">En retard</div></div>
                <div class="stat-box"><div class="stat-value">${streak}🔥</div><div class="stat-label">Série</div></div>
                <div class="stat-box"><div class="stat-value">${total - completed}</div><div class="stat-label">Actives</div></div>
            </div>
            <div style="background:var(--card);border-radius:12px;padding:15px;"><h4>📊 7 jours</h4><canvas id="weeklyChart" width="300" height="150"></canvas></div>`;
        this.drawWeeklyChart();
    }
    drawWeeklyChart() {
        const canvas = document.getElementById('weeklyChart'); if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const days = [];
        for (let i = 6; i >= 0; i--) { const d = new Date(); d.setDate(d.getDate() - i); const ds = d.toISOString().split('T')[0]; days.push({ label: d.toLocaleDateString('fr-FR', { weekday: 'short' }), count: this.data.tasks.filter(t => t.completedAt && t.completedAt.split('T')[0] === ds).length }); }
        const maxVal = Math.max(...days.map(d => d.count), 1);
        const bw = 30, gap = 8, sx = 15, by = canvas.height - 25;
        days.forEach((d, i) => { const h = (d.count / maxVal) * (by - 20); ctx.fillStyle = '#6c5ce7'; ctx.fillRect(sx + i * (bw + gap), by - h, bw, h); ctx.fillStyle = '#636e72'; ctx.font = '10px Inter'; ctx.textAlign = 'center'; ctx.fillText(d.label, sx + i * (bw + gap) + bw/2, by + 12); });
    }

    // ==================== PROJECTS ====================
    renderProjects(container) {
        let html = `<h3 style="margin-bottom:15px;">📁 Projets</h3><div style="display:flex;gap:8px;margin-bottom:15px;"><input type="text" class="form-input" id="newProjectInput" placeholder="Nouveau projet..." style="flex:1;"><button class="btn btn-primary" style="width:auto;" onclick="app.addProject()">+</button></div>`;
        if (this.data.projects.length === 0) html += `<div style="text-align:center;padding:30px;color:var(--text-muted);">Aucun projet</div>`;
        else this.data.projects.forEach(p => { const tasks = this.data.tasks.filter(t => t.project === p); const done = tasks.filter(t => t.completed).length; const prog = tasks.length > 0 ? Math.round((done / tasks.length) * 100) : 0; html += `<div style="background:var(--card);border-radius:12px;padding:12px;margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:8px;"><strong>📁 ${p}</strong><span style="font-size:0.7rem;">${tasks.length} tâches</span></div><div style="background:var(--bg);height:6px;border-radius:3px;"><div style="height:100%;background:var(--primary);width:${prog}%;"></div></div></div>`; });
        container.innerHTML = html;
    }
    addProject() { const input = document.getElementById('newProjectInput'); if (input && input.value.trim()) { this.data.projects.push(input.value.trim()); this.saveData(); this.showToast('📁 Projet créé'); this.render(); } }

    // ==================== TEMPLATES ====================
    renderTemplates(container) {
        let html = `<h3 style="margin-bottom:15px;">📦 Modèles</h3>`;
        if (this.data.templates.length === 0) html += `<div style="text-align:center;padding:30px;color:var(--text-muted);">Aucun modèle</div>`;
        else this.data.templates.forEach(tpl => { html += `<div style="background:var(--card);border-radius:12px;padding:12px;margin-bottom:10px;cursor:pointer;" onclick="app.applyTemplate('${tpl.id}')"><strong>📦 ${tpl.name}</strong><div style="font-size:0.7rem;">${tpl.tasks.length} tâches</div></div>`; });
        html += `<h4 style="margin:15px 0 8px;">Créer</h4><input type="text" class="form-input" id="newTemplateName" placeholder="Nom" style="margin-bottom:8px;"><textarea class="form-textarea" id="newTemplateTasks" placeholder="Tâches (une par ligne)" style="margin-bottom:8px;"></textarea><button class="btn btn-primary" onclick="app.createTemplate()">Créer</button>`;
        container.innerHTML = html;
    }
    applyTemplate(tplId) { const tpl = this.data.templates.find(t => t.id === tplId); if (tpl) { tpl.tasks.forEach(title => { this.data.tasks.unshift({ id: this.generateId(), title, description: '', priority: 'medium', dueDate: null, dueTime: null, tags: [], status: 'todo', completed: false, createdAt: new Date().toISOString(), completedAt: null, subtasks: [], project: null, recurring: null, dependencies: [], archived: false }); }); this.saveData(); this.showToast('📦 Appliqué'); this.render(); } }
    createTemplate() { const name = document.getElementById('newTemplateName').value.trim(); const tasksText = document.getElementById('newTemplateTasks').value.trim(); if (name && tasksText) { this.data.templates.push({ id: this.generateId(), name, tasks: tasksText.split('\n').map(s => s.trim()).filter(s => s) }); this.saveData(); this.showToast('📦 Créé'); this.render(); } }

    // ==================== MIND MAP (simplifié) ====================
    renderMindMap(container) {
        const tasks = this.data.tasks.filter(t => !t.archived);
        container.innerHTML = `<h3 style="margin-bottom:15px;">🧠 Mind Map</h3><div class="mindmap-container" id="mindmapContainer"><div style="display:flex;flex-wrap:wrap;gap:10px;padding:20px;">${tasks.map(t => `<div style="background:var(--card);border:2px solid var(--primary);border-radius:10px;padding:8px 12px;font-size:0.8rem;cursor:pointer;">${t.completed ? '✅' : '○'} ${t.title.substring(0, 30)}</div>`).join('')}</div></div>`;
    }

    // ==================== EXPORT/IMPORT ====================
    exportData(format) {
        if (format === 'csv') { let csv = 'Titre;Priorité;Date;Projet;Statut\n'; this.data.tasks.forEach(t => { csv += `"${t.title}";${t.priority};${t.dueDate||''};${t.project||''};${t.status}\n`; }); this.downloadFile(csv, 'taches.csv', 'text/csv'); }
        else this.downloadFile(JSON.stringify(this.data), 'backup.json', 'application/json');
    }
    downloadFile(content, filename, type) { const blob = new Blob([content], { type }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = filename; a.click(); URL.revokeObjectURL(url); }
    importData() { const input = document.createElement('input'); input.type = 'file'; input.accept = '.json'; input.onchange = (e) => { const f = e.target.files[0]; if (f) { const r = new FileReader(); r.onload = (ev) => { try { this.data = JSON.parse(ev.target.result); this.saveData(); this.render(); this.showToast('✅ Importé'); } catch(err) { this.showToast('❌ Invalide'); } }; r.readAsText(f); } }; input.click(); }
}

const app = new UltraTodoApp();
</script>
</body>
</html>
